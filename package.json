{
  "name": "rebench",
  "version": "1.2.0",
  "private": true,
  "description": "ReBench \u2014 open, reproducible AI benchmarks. AI benchmarks shouldn't be trusted. They should be reproduced.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:runner": "python3 -m pytest benchmark/tests/ -q",
    "test:all": "npm test && npm run test:runner",
    "validate": "node scripts/validate-data.mjs",
    "validate:record": "node scripts/validate-record.mjs",
    "generate:data": "node scripts/generate-data.mjs",
    "generate:types": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  }
}
