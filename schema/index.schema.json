{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nilabh-code/ReBench/blob/main/schema/index.schema.json",
  "title": "ReBench index",
  "description": "The generated projection of results/ that the website reads. Produced by scripts/generate-data.mjs; never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated", "generator", "demo", "benchmarkVersion", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "generated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "ISO-8601 UTC instant the index was produced. Must not precede any record."
    },
    "generator": { "type": "string", "minLength": 1, "maxLength": 200 },
    "demo": {
      "type": "boolean",
      "description": "True while the records are synthetic. The website reads this to label itself."
    },
    "note": { "type": "string", "maxLength": 500 },
    "benchmarkVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": { "$ref": "https://github.com/Nilabh-code/ReBench/blob/main/schema/benchmark.schema.json" }
    }
  }
}
